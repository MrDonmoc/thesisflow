# Supabase Configuration
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_PROJECT_ID=your_supabase_project_id

# OpenAI Configuration (for topic atomization)
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Optional: Google Gemini API (alternative to OpenAI)
GEMINI_API_KEY=your_gemini_api_key

# Optional: Semantic Scholar API (alternative paper source)
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key

# Application Configuration
NEXT_PUBLIC_APP_NAME=ThesisFlow
NEXT_PUBLIC_APP_DESCRIPTION=Research Operating System for PhD Scholars

# Optional: Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_vercel_analytics_id